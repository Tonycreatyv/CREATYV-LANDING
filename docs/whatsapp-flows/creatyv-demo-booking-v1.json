{
  "version": "7.3",
  "screens": [
    {
      "id": "CALENDAR",
      "title": "Elegir fecha",
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "calendar_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Elegí una fecha"
              },
              {
                "type": "TextBody",
                "text": "Seleccioná el día que te quede mejor."
              },
              {
                "type": "CalendarPicker",
                "name": "appointment_date",
                "label": "Fecha",
                "mode": "single",
                "required": true,
                "min-date": "2026-10-24",
                "max-date": "2026-12-31",
                "include-days": ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat"]
              },
              {
                "type": "Footer",
                "label": "Ver horarios",
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "TIME"
                  },
                  "payload": {
                    "appointment_date": "${form.appointment_date}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "TIME",
      "title": "Elegir hora",
      "data": {
        "appointment_date": {
          "type": "string",
          "__example__": "2026-10-26"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "time_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Horarios disponibles"
              },
              {
                "type": "TextBody",
                "text": "Elegí la hora que mejor te funcione."
              },
              {
                "type": "ChipsSelector",
                "name": "appointment_time",
                "label": "Hora",
                "required": true,
                "min-selected-items": 1,
                "max-selected-items": 1,
                "data-source": [
                  {
                    "id": "15:30",
                    "title": "3:30 p. m."
                  },
                  {
                    "id": "16:00",
                    "title": "4:00 p. m."
                  },
                  {
                    "id": "16:30",
                    "title": "4:30 p. m."
                  },
                  {
                    "id": "17:00",
                    "title": "5:00 p. m."
                  }
                ]
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "DETAILS"
                  },
                  "payload": {}
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "DETAILS",
      "title": "Tus datos",
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "details_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Tus datos"
              },
              {
                "type": "TextBody",
                "text": "Solo necesitamos esto para completar la cita."
              },
              {
                "type": "TextInput",
                "name": "name",
                "label": "Nombre",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "phone",
                "label": "Teléfono",
                "input-type": "phone",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Revisar",
                "on-click-action": {
                  "name": "navigate",
                  "next": {
                    "type": "screen",
                    "name": "CONFIRM"
                  },
                  "payload": {
                    "name": "${form.name}",
                    "phone": "${form.phone}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CONFIRM",
      "title": "Confirmación",
      "terminal": true,
      "success": true,
      "data": {
        "name": {
          "type": "string",
          "__example__": "Ana García"
        },
        "phone": {
          "type": "string",
          "__example__": "+14045550199"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "confirm_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Tu cita está lista"
              },
              {
                "type": "TextBody",
                "text": "Al finalizar, Creatyv puede guardar la cita y continuar con recordatorios o seguimiento por WhatsApp."
              },
              {
                "type": "Footer",
                "label": "Finalizar demo",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "appointment_date": "${screen.CALENDAR.form.appointment_date}",
                    "appointment_time": "${screen.TIME.form.appointment_time}",
                    "name": "${data.name}",
                    "phone": "${data.phone}",
                    "demo": true
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
