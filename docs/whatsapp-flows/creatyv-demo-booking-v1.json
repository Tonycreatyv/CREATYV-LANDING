{
  "version": "7.3",
  "screens": [
    {
      "id": "TIME",
      "title": "Elegir hora",
      "data": {
        "service": { "type": "string", "__example__": "Consulta general" },
        "requested_date": { "type": "string", "__example__": "2026-10-25" },
        "requested_time_window": { "type": "string", "__example__": "después de las 3:00 p. m." }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "time_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "Horarios disponibles"
              },
              {
                "type": "TextBody",
                "text": "Ya entendí que buscás ${data.service} para ${data.requested_date}, ${data.requested_time_window}. Elegí el horario que te convenga."
              },
              {
                "type": "RadioButtonsGroup",
                "name": "appointment_time",
                "label": "Elige una hora",
                "required": true,
                "data-source": [
                  { "id": "15:30", "title": "3:30 p. m." },
                  { "id": "16:00", "title": "4:00 p. m." },
                  { "id": "16:30", "title": "4:30 p. m." },
                  { "id": "17:00", "title": "5:00 p. m." }
                ]
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "navigate",
                  "next": { "type": "screen", "name": "DETAILS" },
                  "payload": {
                    "service": "${data.service}",
                    "requested_date": "${data.requested_date}",
                    "requested_time_window": "${data.requested_time_window}",
                    "appointment_time": "${form.appointment_time}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "DETAILS",
      "title": "Tus datos",
      "data": {
        "service": { "type": "string", "__example__": "Consulta general" },
        "requested_date": { "type": "string", "__example__": "2026-10-25" },
        "requested_time_window": { "type": "string", "__example__": "después de las 3:00 p. m." },
        "appointment_time": { "type": "string", "__example__": "16:00" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "details_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "¿A nombre de quién?"
              },
              {
                "type": "TextInput",
                "name": "name",
                "label": "Nombre",
                "required": true
              },
              {
                "type": "TextInput",
                "name": "phone",
                "label": "Teléfono",
                "input-type": "phone",
                "required": true
              },
              {
                "type": "Footer",
                "label": "Revisar",
                "on-click-action": {
                  "name": "navigate",
                  "next": { "type": "screen", "name": "CONFIRM" },
                  "payload": {
                    "service": "${data.service}",
                    "requested_date": "${data.requested_date}",
                    "requested_time_window": "${data.requested_time_window}",
                    "appointment_time": "${data.appointment_time}",
                    "name": "${form.name}",
                    "phone": "${form.phone}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CONFIRM",
      "title": "Confirmación",
      "terminal": true,
      "success": true,
      "data": {
        "service": { "type": "string", "__example__": "Consulta general" },
        "requested_date": { "type": "string", "__example__": "2026-10-25" },
        "requested_time_window": { "type": "string", "__example__": "después de las 3:00 p. m." },
        "appointment_time": { "type": "string", "__example__": "16:00" },
        "name": { "type": "string", "__example__": "Ana García" },
        "phone": { "type": "string", "__example__": "+14045550199" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "confirm_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "¡Listo!"
              },
              {
                "type": "TextBody",
                "text": "Esta es una cita simulada de Creatyv. En una instalación real, el negocio recibiría la solicitud y Creatyv podría continuar el seguimiento por WhatsApp."
              },
              {
                "type": "Footer",
                "label": "Finalizar demo",
                "on-click-action": {
                  "name": "complete",
                  "payload": {
                    "service": "${data.service}",
                    "requested_date": "${data.requested_date}",
                    "requested_time_window": "${data.requested_time_window}",
                    "appointment_time": "${data.appointment_time}",
                    "name": "${data.name}",
                    "phone": "${data.phone}",
                    "demo": true
                  }
                }
              }
            ]
          }
        ]
      }
    }
  ]
}
