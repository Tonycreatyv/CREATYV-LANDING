{
  "version": "7.3",
  "data_api_version": "3.0",
  "routing_model": {
    "SERVICE": ["CALENDAR", "TIME", "CONFIRM"],
    "CALENDAR": ["TIME", "CONFIRM"],
    "TIME": ["CONFIRM"],
    "CONFIRM": []
  },
  "screens": [
    {
      "id": "SERVICE",
      "title": "Tu cita",
      "data": {
        "service_options": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "consultation", "title": "Consulta dental" },
            { "id": "cleaning", "title": "Limpieza" }
          ]
        },
        "known_date": { "type": "string", "__example__": "" },
        "known_time": { "type": "string", "__example__": "" },
        "location_name": { "type": "string", "__example__": "Sucursal principal" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "service_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "¿Qué servicio necesitas?"
              },
              {
                "type": "RadioButtonsGroup",
                "name": "service_id",
                "label": "Servicio",
                "required": true,
                "data-source": "${data.service_options}"
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "step": "service",
                    "service_id": "${form.service_id}",
                    "known_date": "${data.known_date}",
                    "known_time": "${data.known_time}",
                    "location_name": "${data.location_name}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CALENDAR",
      "title": "Tu cita",
      "data": {
        "service_id": { "type": "string", "__example__": "consultation" },
        "service_name": { "type": "string", "__example__": "Consulta dental" },
        "known_time": { "type": "string", "__example__": "15:00" },
        "location_name": { "type": "string", "__example__": "Sucursal principal" },
        "min_date": { "type": "string", "__example__": "2026-10-26" },
        "max_date": { "type": "string", "__example__": "2026-12-31" },
        "unavailable_dates": {
          "type": "array",
          "items": { "type": "string" },
          "__example__": []
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "calendar_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "¿Qué día te queda mejor?"
              },
              {
                "type": "TextBody",
                "text": "Solo mostramos fechas que Core puede atender."
              },
              {
                "type": "CalendarPicker",
                "name": "appointment_date",
                "label": "Fecha",
                "mode": "single",
                "required": true,
                "min-date": "${data.min_date}",
                "max-date": "${data.max_date}",
                "unavailable-dates": "${data.unavailable_dates}"
              },
              {
                "type": "Footer",
                "label": "Ver horarios",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "step": "date",
                    "service_id": "${data.service_id}",
                    "appointment_date": "${form.appointment_date}",
                    "known_time": "${data.known_time}",
                    "location_name": "${data.location_name}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "TIME",
      "title": "Tu cita",
      "data": {
        "service_id": { "type": "string", "__example__": "consultation" },
        "service_name": { "type": "string", "__example__": "Consulta dental" },
        "appointment_date": { "type": "string", "__example__": "2026-10-26" },
        "location_name": { "type": "string", "__example__": "Sucursal principal" },
        "available_slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "title": { "type": "string" }
            }
          },
          "__example__": [
            { "id": "15:00", "title": "3:00 p. m." },
            { "id": "15:30", "title": "3:30 p. m." }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "time_form",
            "children": [
              {
                "type": "TextHeading",
                "text": "¿A qué hora te funciona?"
              },
              {
                "type": "TextBody",
                "text": "Estos horarios vienen de la disponibilidad real de Core."
              },
              {
                "type": "ChipsSelector",
                "name": "appointment_time",
                "label": "Hora",
                "required": true,
                "min-selected-items": 1,
                "max-selected-items": 1,
                "data-source": "${data.available_slots}"
              },
              {
                "type": "Footer",
                "label": "Revisar cita",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "step": "time",
                    "service_id": "${data.service_id}",
                    "appointment_date": "${data.appointment_date}",
                    "appointment_time": "${form.appointment_time}",
                    "location_name": "${data.location_name}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "CONFIRM",
      "title": "Confirma tu cita",
      "terminal": true,
      "success": true,
      "data": {
        "service_id": { "type": "string", "__example__": "consultation" },
        "service_name": { "type": "string", "__example__": "Consulta dental" },
        "appointment_date": { "type": "string", "__example__": "2026-10-26" },
        "appointment_time": { "type": "string", "__example__": "15:00" },
        "appointment_time_label": { "type": "string", "__example__": "3:00 p. m." },
        "location_name": { "type": "string", "__example__": "Sucursal principal" }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Revisa antes de confirmar"
          },
          {
            "type": "TextBody",
            "text": "${data.service_name} · ${data.appointment_date} · ${data.appointment_time_label} · ${data.location_name}"
          },
          {
            "type": "Footer",
            "label": "Confirmar cita",
            "on-click-action": {
              "name": "complete",
              "payload": {
                "service_id": "${data.service_id}",
                "service_name": "${data.service_name}",
                "appointment_date": "${data.appointment_date}",
                "appointment_time": "${data.appointment_time}",
                "location_name": "${data.location_name}",
                "demo": true
              }
            }
          }
        ]
      }
    }
  ]
}
